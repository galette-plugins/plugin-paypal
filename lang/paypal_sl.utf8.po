#: ../lib/GalettePaypal/Controllers/PaypalController.php:55
msgid "Paypal payment"
msgstr "Plačilo s PayPalom"

#: ../lib/GalettePaypal/Controllers/PaypalController.php:66
msgid ""
"<strong>Payment could not work</strong>: An error occurred (that has been "
"logged) while loading Paypal preferences from database.<br/>Please report "
"the issue to the staff."
msgstr ""
"<strong>Plačilo ni moglo delovati</strong>: Pri nalaganju nastavitev PayPala "
"iz baze podatkov je prišlo do napake (ki je bila zabeležena).<br/>Prosimo, "
"da težavo prijavite osebju."

#: ../lib/GalettePaypal/Controllers/PaypalController.php:67
msgid "Our apologies for the annoyance :("
msgstr "Opravičujemo se za nevšečnost :("

#: ../lib/GalettePaypal/Controllers/PaypalController.php:74
msgid ""
"Paypal id has not been defined. Please ask an administrator to add it from "
"plugin preferences."
msgstr ""
"PayPal Id ni bil določen. Prosite skrbnika, da ga doda v nastavitvah "
"vtičnika."

#: ../lib/GalettePaypal/Controllers/PaypalController.php:127
#: ../lib/GalettePaypal/PluginGalettePaypal.php:50
msgid "Paypal History"
msgstr "Zgodovina Paypala"

#: ../lib/GalettePaypal/Controllers/PaypalController.php:186
msgid "Paypal Settings"
msgstr "Nastavitve PayPala"

#: ../lib/GalettePaypal/Controllers/PaypalController.php:224
msgid "Paypal preferences has been saved."
msgstr "Nastavitve PayPala so shranjene."

#: ../lib/GalettePaypal/Controllers/PaypalController.php:230
msgid "An error occurred saving paypal preferences :("
msgstr "Pri shranjevanju nastavitev PayPala je prišlo do napake :("

#: ../lib/GalettePaypal/Controllers/PaypalController.php:249
msgid "Your payment has been aborted!"
msgstr "Vaše plačilo je bilo prekinjeno!"

#: ../lib/GalettePaypal/Controllers/PaypalController.php:272
msgid "Paypal payment success"
msgstr "Plačilo prek PayPala je bilo uspešno"

#: ../lib/GalettePaypal/Controllers/PaypalController.php:278
msgid "Your payment has been proceeded!"
msgstr "Vaše plačilo je bilo obdelano!"

#: ../lib/GalettePaypal/PluginGalettePaypal.php:46
msgid "Paypal"
msgstr "Paypal"

#: ../lib/GalettePaypal/PluginGalettePaypal.php:77
#: ../lib/GalettePaypal/PluginGalettePaypal.php:101
msgid "Payment form"
msgstr "Plačilni obrazec"

#: ../templates/default/paypal_form.html.twig:14
msgid "Enter payment reason"
msgstr "Vnesite razlog za plačilo"

#: ../templates/default/paypal_form.html.twig:16
msgid "Payment reason"
msgstr "Razlog za plačilo"

#: ../templates/default/paypal_form.html.twig:18
msgid "Select a payment reason"
msgstr "Izberite razlog za plačilo"

#: ../templates/default/paypal_form.html.twig:44
msgid "Payment reason:"
msgstr "Razlog plačila:"

#: ../templates/default/paypal_form.html.twig:60
msgid "Pay with paypal"
msgstr "Plačaj s PayPalom"

#: ../templates/default/paypal_form.html.twig:82
#, php-format
msgid "Go back to %s's website to complete your inscription."
msgstr "Vrnite se na spletno mesto %s, da dokončate svoj vpis."

#: ../templates/default/paypal_form.html.twig:104
msgid "You have to select an option"
msgstr "Izbrati morate možnost"

#: ../templates/default/paypal_form.html.twig:110
msgid "Please enter an amount."
msgstr "Prosimo, vnesite znesek."

#: ../templates/default/paypal_form.html.twig:113
msgid ""
"The amount you've entered is lower than the minimum amount for the selected "
"option.\n"
"Please choose another option or change the amount."
msgstr ""
"Vneseni znesek je nižji od minimalnega zneska za izbrano možnost. \n"
"Izberite drugo možnost ali spremenite znesek."

#: ../templates/default/paypal_preferences.html.twig:16
msgid "Cannot load the preferences"
msgstr "Nastavitev ni mogoče naložiti"

#: ../templates/default/paypal_preferences.html.twig:19
msgid "An error occurred while loading the preferences from the database."
msgstr "Pri nalaganju nastavitev iz baze podatkov je prišlo do napake."

#: ../templates/default/paypal_preferences.html.twig:20
msgid "Please, check if the plugin's database has been properly initialized."
msgstr ""
"Prosim, preverite, ali je bila baza podatkov vtičnika pravilno "
"inicializirana."

#: ../templates/default/paypal_preferences.html.twig:29
msgid "Paypal identifier:"
msgstr "Identifikator PayPala:"

#: ../templates/default/paypal_preferences.html.twig:29
msgid ""
"Enter here one of your Paypal ID or email adress associated within your "
"paypal account."
msgstr ""
"Tukaj vnesite enega od svojih PayPal ID-jev ali e-poštnih naslovov, "
"povezanih z vašim PayPal računom."

#: ../templates/default/paypal_preferences.html.twig:43
msgid "Amounts can be defined in the contributions types settings."
msgstr "Zneske je mogoče določiti v nastavitvah vrst prispevkov."

#: ../templates/default/paypal_preferences.html.twig:68
msgid "Error: no predefined amounts found."
msgstr "Napaka: ni bilo najdenih vnaprej določenih zneskov."

#: ../templates/default/paypal_history.html.twig:29
#: ../templates/default/paypal_history.html.twig:96
msgid "Request"
msgstr "Zahteva"

#: ../templates/default/paypal_history.html.twig:67
#: ../templates/default/paypal_history.html.twig:69
msgid "duplicate"
msgstr "dvojnik"

#: ../templates/default/paypal_history.html.twig:83
msgid "No request or unable to read request"
msgstr "Ni zahteve ali zahteve ni mogoče prebrati"

#: ../templates/default/paypal_history.html.twig:99
msgid "Show/hide full request"
msgstr "Prikaži/skrij celotno zahtevo"

#: ../templates/default/paypal_success.html.twig:11
msgid "Your paypal payment was successful. Some details are shown below:"
msgstr ""
"Vaše plačilo prek PayPala je bilo uspešno. Spodaj so prikazane nekatere "
"podrobnosti:"

#: ../templates/default/paypal_success.html.twig:35
msgid ""
"Your paypal payment was successful. You may receive a mail from paypal with "
"details."
msgstr ""
"Vaše plačilo prek PayPala je bilo uspešno. Morda boste prejeli e-pošto od "
"PayPala s podrobnostmi."
